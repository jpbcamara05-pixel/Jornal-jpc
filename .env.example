# ===== LLM =====
ANTHROPIC_API_KEY=sk-ant-...

# ===== Fontes (login com assinatura própria) =====
# Valor Econômico / Globo (login.globo.com) — usado só para gerar o perfil de navegador local
GLOBO_EMAIL=
GLOBO_PASSWORD=
# Caminho do perfil persistente do Playwright com os cookies de sessão (não versionar)
BROWSER_PROFILE_DIR=./browser_profile

# Newsletters por e-mail (alternativa/complemento à raspagem) — Gmail com senha de app
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# NYT Developer API (gratuita) — Top Stories / Article Search
NYT_API_KEY=

# ===== TTS =====
TTS_PROVIDER=edge            # edge (grátis, dev) | google (Chirp 3 HD, 1M chars/mês grátis — produção) | openai | elevenlabs
EDGE_TTS_VOICE=pt-BR-AntonioNeural
GOOGLE_APPLICATION_CREDENTIALS=   # JSON da service account (TTS_PROVIDER=google)
GOOGLE_TTS_VOICE=pt-BR-Chirp3-HD-Charon
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPUS_BITRATE=24k

# ===== Entrega =====
DELIVERY_PROVIDER=whatsapp_waha   # whatsapp_waha | whatsapp_cloud | whatsapp_evolution | telegram | console (só imprime)
# WAHA (self-hosted, Docker, gratuito) — sessão lida por QR com um CHIP RESERVA
WAHA_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default
# Evolution API (alternativa self-hosted)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=briefing
WHATSAPP_TO=5511999999999           # seu próprio número, DDI+DDD+número
# Meta WhatsApp Cloud API (oficial)
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
# Telegram (fallback de entrega, trivial de configurar)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Execução =====
TZ=America/Sao_Paulo
RUN_HOUR=06:30
