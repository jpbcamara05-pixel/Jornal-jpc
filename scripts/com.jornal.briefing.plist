<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd (macOS): cp para ~/Library/LaunchAgents/ e `launchctl load ~/Library/LaunchAgents/com.jornal.briefing.plist`
     Ajuste o caminho absoluto de run_daily.sh. Roda seg–sex 06:30.
     O Mac precisa estar ACORDADO: `sudo pmset repeat wakeorpoweron MTWRF 06:25:00`
     (launchd executa um job perdido só no próximo despertar). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jornal.briefing</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Users/joaopedrocamara/Documents/VS/Jornal/scripts/run_daily.sh</string></array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/joaopedrocamara/Documents/VS/Jornal/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/joaopedrocamara/Documents/VS/Jornal/logs/launchd.err</string>
</dict>
</plist>
